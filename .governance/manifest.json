        "Cargo.lock",
        "pom.xml",
        "operations/**",
        "events/**",
        "error/**",
        "models/**",
        "proto/**"
      ],
      "workstream": "integration"
    },
    "maxActiveTicketsPerWorkstream": 8,
    "mode": "workstreams",
    "rejectActiveScopeOverlap": true,
    "workstreams": {
      "application": {
        "ownedPaths": [
          "src/**",
          "app/**",
          "lib/**",
          "packages/**",
          "test/**",
          "tests/**",
