          ".gitattributes",
          ".githooks/pre-commit",
          ".github/copilot-instructions.md",
          ".github/workflows/new-project-branch-hygiene.yml",
          ".github/workflows/new-project-governance.yml",
          ".gitignore",
          ".governance/AGENT_DECISIONS.md",
          ".governance/adoption-bindings.json",
