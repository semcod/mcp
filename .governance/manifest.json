          ".governance/error/GOV-TICKET-ACTIVITY.md",
          ".governance/error/GOV-TICKET-ALLOCATION.md",
          ".governance/error/GOV-WORK-CONTINUITY.md",
          ".governance/error/GOV-WORK-START.md",
          ".governance/error/GOV-WORKSPACE-LIFECYCLE.md",
